# 복사해서 .env 로 쓰면 전결 서버가 읽습니다. 없으면 아래 기본값을 씁니다.
# APPROVAL_PORT=8000
# APPROVAL_HOST=127.0.0.1
# APPROVAL_BASE_URL=http://localhost:8000      # 화면 링크(툴 결과의 link)에 쓰는 주소. 배포 때는 공개 주소(https://…)
# APPROVAL_DB=data/approval.db
# APPROVAL_SEED_DIR=seed
# APPROVAL_TICK_SECONDS=15                     # 알림 주기 작업 간격(실제 초)

# ── 서버 배포용 (approval-server deploy, Dockerfile) ──
# APPROVAL_MCP_MOUNT=1                         # MCP 연결을 웹과 같은 포트의 /mcp/<비밀값>/<slug>, /mcp(헤더 토큰)에 연다
# APPROVAL_MCP_SECRET=<임의 문자열>             # MCP 주소 비밀값. 없으면 data/mcp_secret.txt에 만들어 쓴다
# APPROVAL_INTERNAL_URL=http://127.0.0.1:8000  # MCP 툴이 REST API를 부르는 내부 주소
# APPROVAL_PUBLIC_HOSTS=demo.example.com       # Host·Origin 검사에 더 허용할 호스트(쉼표). APPROVAL_BASE_URL의 호스트는 자동 포함
# APPROVAL_ADMIN_KEY=<운영자 키>                # 두면 시연 제어 패널의 초기화·시계·확인 방식은 운영자 키를 넣은 브라우저에서만
# APPROVAL_SITE_KEY=<입장 코드>                 # 두면 웹 화면은 입장 코드를 넣은 브라우저만(30일 기억). 링크 https://<주소>/?enter=<코드>
# APPROVAL_API_PUBLIC=1                        # 배포 모드에서도 REST API를 밖에서 연결 토큰으로 부르게 연다(Claude Desktop stdio용. 보통 끔)
# APPROVAL_CLOCK_FLOW=frozen                   # 시연 시계를 멈춘다(여러 날 켜 두는 서버에서 대본 날짜가 어긋나지 않게)
